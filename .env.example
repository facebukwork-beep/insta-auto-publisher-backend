APP_SECRET_KEY=replace-with-a-long-random-secret
GRAPH_API_VERSION=v23.0
DATABASE_URL=postgresql://...
REQUIRE_RESTART_SAFE_STORAGE=true
KEEP_MEDIA_AFTER_PUBLISH_HOURS=2

# FREE Google Drive media storage (preferred when R2 payment setup is unavailable)
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_ID=

# Alternative S3/R2 media storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=false
