# REQUIRED. NEVER change this after accounts are connected.
APP_SECRET_KEY=put-a-long-random-secret-here
GRAPH_API_VERSION=v23.0

# Safety: v14 blocks new scheduling until BOTH state and media are restart-safe.
REQUIRE_RESTART_SAFE_STORAGE=true

# Scheduler tuning
PREPARE_AHEAD_MINUTES=10
META_MIN_REQUEST_INTERVAL_SECONDS=10
META_RATE_LIMIT_BACKOFF_MINUTES=30
MAX_AUTO_RETRIES=8
KEEP_MEDIA_AFTER_PUBLISH_HOURS=24

# ===== OPTION 1: One persistent disk (simple, usually paid host/disk) =====
# PERSISTENT_ROOT=/var/data

# ===== OPTION 2: Recommended for Render web service =====
# Durable state: PostgreSQL (Neon / Supabase / Render Postgres etc.)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Durable public media: S3-compatible object storage (Cloudflare R2 / S3 / etc.)
# The public base URL MUST be reachable by Meta's servers without login.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=insta-auto-publisher
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
# S3_FORCE_PATH_STYLE=false
